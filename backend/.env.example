
# Application
APP_NAME=Clinora
ENVIRONMENT=development
APP_TIMEZONE=Asia/Kolkata

# Database
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=45
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Google Maps
GOOGLE_MAPS_API_KEY=

# Calendar API
CALENDAR_API_BASE_URL=https://calendar-api-d7a8.onrender.com
CALENDAR_API_KEY=

# File uploads
UPLOAD_DIR=private_uploads
MAX_UPLOAD_MB=10

# Frontend access
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Google authentication
GOOGLE_CLIENT_ID=

POSTGRES_USER=clinora
POSTGRES_PASSWORD=change_me
POSTGRES_DB=clinora

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Password reset
PASSWORD_RESET_MINUTES=20
